<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E11"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DARKNET CDN Scanner"
        android:textColor="#E6EDF3"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/scanner_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textColor="#8B949E"
        android:textSize="14sp"
        android:paddingBottom="12dp" />

    <!-- Live status card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161B22"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current IP"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/scanner_current_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#58A6FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ping"
                android:textColor="#8B949E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/scanner_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#3FB950"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/scanner_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/scanner_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 0"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:gravity="end"
            android:paddingTop="4dp" />
    </LinearLayout>

    <Spinner
        android:id="@+id/scanner_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#21262D"
        android:padding="8dp" />

    <Spinner
        android:id="@+id/scanner_provider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#21262D"
        android:padding="8dp" />

    <EditText
        android:id="@+id/scanner_custom_ranges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#21262D"
        android:gravity="top|start"
        android:hint="Extra / custom ranges, one per line (e.g. 23.0.0.0/12)"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minLines="2"
        android:padding="8dp"
        android:textColor="#E6EDF3"
        android:textColorHint="#8B949E"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/scanner_list_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#21262D"
        android:gravity="top|start"
        android:hint="IPs, CIDRs, a-b ranges or domains (comma, space or new line)"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minLines="4"
        android:padding="8dp"
        android:textColor="#E6EDF3"
        android:textColorHint="#8B949E"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/scanner_range_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/scanner_start_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#21262D"
            android:hint="Start  1.1.1.0"
            android:inputType="textNoSuggestions"
            android:padding="8dp"
            android:singleLine="true"
            android:textColor="#E6EDF3"
            android:textColorHint="#8B949E"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/scanner_end_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#21262D"
            android:hint="End  1.1.1.255"
            android:inputType="textNoSuggestions"
            android:padding="8dp"
            android:singleLine="true"
            android:textColor="#E6EDF3"
            android:textColorHint="#8B949E"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/scanner_toggle_adv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Advanced settings ▾" />

    <LinearLayout
        android:id="@+id/scanner_adv_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/scanner_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Start" />

        <Button
            android:id="@+id/scanner_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Stop" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/scanner_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Apply to CDN" />

        <Button
            android:id="@+id/scanner_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Copy IPs" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="Best results"
        android:textColor="#E6EDF3"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scanner_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1117"
        android:nestedScrollingEnabled="false" />

</LinearLayout>
</androidx.core.widget.NestedScrollView>
